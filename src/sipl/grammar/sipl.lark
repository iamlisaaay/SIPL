// =====================================================================
//  SIPL grammar (Lark, Earley parser)
//
//  Канонічна машинозчитувана граматика мови SIPL.
//  Ядро (dialect "core") точно відповідає БНФ практикуму
//  (Шишацька, Криволап, Шишацький, 2024, с. 8-9):
//
//    P ::= begin S end                                          P1
//    S ::= x := a | S1 ; S2 | if b then S1 else S2
//        | while b do S | begin S end | skip                    S1-S6
//    a ::= n | x | a1 + a2 | a1 - a2 | a1 * a2 | (a)            A1-A6
//    b ::= a1 = a2 | a1 > a2 | b1 ∨ b2 | ¬ b | (b)              B1-B5
//
//  Неоднозначність БНФ знято пріоритетами (з найслабшого):
//    ;  <  while/if (тіло – один оператор)
//    ∨  <  ∧  <  ¬  <  порівняння
//    + -  <  * div mod      (усі бінарні операції лівоасоціативні)
//
//  Розширення (dialect "ext", позначені [EXT]) описані в docs/spec.md:
//  >= <= < != ∧ div mod true false, коментарі //...
//  Конструкції [SPEC] (→, виклики функцій) дозволені лише у формулах
//  специфікацій для асистента доведення (SEM-04).
// =====================================================================

start: program

// ---------- програми та оператори ----------
program: BEGIN stmts END                          // P1

stmts: stmt (SEMI stmt)*                          // S2 (послідовність)

?stmt: assign
     | if_stmt
     | while_stmt
     | block
     | skip

assign: VAR ASSIGN aexp                           // S1
if_stmt: IF bexp THEN stmt ELSE stmt              // S3
while_stmt: WHILE bexp DO stmt                    // S4
block: BEGIN stmts END                            // S5
skip: SKIP                                        // S6

// ---------- арифметичні вирази ----------
?aexp: sum

?sum: product
    | sum PLUS product        -> add              // A3
    | sum MINUS product       -> sub              // A4

?product: atom
    | product STAR atom       -> mul              // A5
    | product DIV atom        -> div              // [EXT]
    | product MOD atom        -> mod              // [EXT]

?atom: NUMBER                 -> num              // A1
     | MINUS NUMBER           -> neg_num          // A1 (від'ємне число)
     | VAR                    -> var              // A2
     | LPAR aexp RPAR         -> paren_a          // A6
     | VAR LPAR args RPAR     -> call             // [SPEC]

args: aexp (COMMA aexp)*

// ---------- умови ----------
?bexp: disj

?disj: conj
     | disj OR conj           -> or_              // B3

?conj: negation
     | conj AND negation      -> and_             // [EXT]

?negation: batom
     | NOT negation           -> not_             // B4

?batom: aexp EQ aexp          -> eq               // B1
      | aexp GT aexp          -> gt               // B2
      | aexp GE aexp          -> ge               // [EXT]
      | aexp LT aexp          -> lt               // [EXT]
      | aexp LE aexp          -> le               // [EXT]
      | aexp NE aexp          -> ne               // [EXT]
      | TRUE                  -> true_            // [EXT]
      | FALSE                 -> false_           // [EXT]
      | LPAR implication RPAR -> paren_b          // B5 (→ лише у специфікаціях)

// ---------- формули специфікацій [SPEC] ----------
formula: implication
?implication: bexp
     | bexp IMPLIES implication -> implies

expr: aexp                     // окрема точка входу для варіанта циклу

// ---------- лексика ----------
BEGIN: "begin"
END: "end"
IF: "if"
THEN: "then"
ELSE: "else"
WHILE: "while"
DO: "do"
SKIP: "skip"
DIV: "div"
MOD: "mod"
TRUE: "true"
FALSE: "false"

// словесні форми задано регулярними виразами з \b, щоб "order" лишався змінною
OR.2: /∨|\bor\b|\\\//
AND.2: /∧|\band\b|\/\\|&/
NOT.2: /¬|\bnot\b|~/
IMPLIES.2: /->|→/

ASSIGN: ":="
SEMI: ";"
COMMA: ","
LPAR: "("
RPAR: ")"
PLUS: "+"
MINUS: "-" | "−" | "–"
STAR: "*" | "∗" | "×"
GE: ">=" | "≥"
LE: "<=" | "≤"
NE: "!=" | "≠" | "<>"
EQ: "="
GT: ">"
LT: "<"

VAR: /[A-Za-z_][A-Za-z0-9_]*/
NUMBER: /[0-9]+/

COMMENT: /\/\/[^\n]*/
%import common.WS
%ignore WS
%ignore COMMENT
